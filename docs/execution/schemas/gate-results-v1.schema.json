{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate-results-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "gate_run_at", "git_object_format", "head_oid", "phase_base_oid", "tool_versions", "results", "overall_status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string"},
    "gate_run_at": {"type": "string", "format": "date-time"},
    "git_object_format": {"enum": ["sha1", "sha256"]},
    "head_oid": {"type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"},
    "phase_base_oid": {"type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"},
    "tool_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "detail", "evidence_path", "evidence_sha256"],
        "properties": {
          "check_id": {"type": "string"},
          "status": {"enum": ["passed", "failed", "blocked", "not_applicable"]},
          "detail": {"type": "string"},
          "evidence_path": {"type": "string"},
          "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "overall_status": {"enum": ["passed", "failed", "blocked", "not_applicable"]}
  }
}
