{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commands-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "phase", "executed_at", "executor", "git_object_format", "head_oid", "commands"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^TASK-"},
    "phase": {"type": "string"},
    "executed_at": {"type": "string", "format": "date-time"},
    "executor": {"type": "string", "minLength": 1},
    "git_object_format": {"enum": ["sha1", "sha256"]},
    "head_oid": {"type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "description", "command", "exit_code", "stdout_tail", "stderr_tail", "stdout_sha256", "stderr_sha256", "duration_seconds", "redaction_reason"],
        "properties": {
          "step": {"type": "integer", "minimum": 1},
          "description": {"type": "string"},
          "command": {"type": "string"},
          "exit_code": {"type": "integer"},
          "stdout_tail": {"type": "string", "maxLength": 200},
          "stderr_tail": {"type": "string", "maxLength": 200},
          "stdout_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "stderr_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "redaction_reason": {"type": "string"},
          "duration_seconds": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
