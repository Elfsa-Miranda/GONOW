{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact-hashes-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "git_object_format", "head_oid", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string"},
    "git_object_format": {"enum": ["sha1", "sha256"]},
    "head_oid": {"type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path_or_reference", "sha256", "size_bytes", "mime_type", "artifact_type", "generated_by_step", "generated_at", "sensitivity", "retention"],
        "properties": {
          "path_or_reference": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "mime_type": {"type": "string", "minLength": 1},
          "artifact_type": {"type": "string", "minLength": 1},
          "generated_by_step": {"type": "string", "minLength": 1},
          "generated_at": {"type": "string", "format": "date-time"},
          "sensitivity": {"type": "string", "minLength": 1},
          "retention": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
