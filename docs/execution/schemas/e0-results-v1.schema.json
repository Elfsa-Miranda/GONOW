{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gonow.invalid/schemas/e0-results-v1.json",
  "title": "GoNow E0 parity result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "execution_mode",
    "formal_approval_status",
    "production_validation",
    "immutable_inputs",
    "case_counts",
    "adapter_descriptors",
    "case_results",
    "parity",
    "quality",
    "latency",
    "cost",
    "security",
    "unexpected_dataset_diff",
    "production_write_count"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"const": "TASK-P04-010"},
    "execution_mode": {"const": "local_provisional_synthetic"},
    "formal_approval_status": {"const": "pending_external"},
    "production_validation": {"const": false},
    "immutable_inputs": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "required": ["dataset_sha256", "schema_sha256", "scoring_sha256", "manifest_sha256", "requests_sha256", "labels_sha256"]
    },
    "case_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "per_adapter", "total_results"],
      "properties": {
        "dataset": {"const": 40},
        "per_adapter": {"const": 40},
        "total_results": {"const": 80}
      }
    },
    "adapter_descriptors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter_id", "kind", "uses_current_graph"],
        "properties": {
          "adapter_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["deterministic_compatibility_fixture", "deterministic_single_agent_fixture"]},
          "uses_current_graph": {"type": "boolean"}
        }
      }
    },
    "case_results": {
      "type": "array",
      "minItems": 80,
      "maxItems": 80,
      "items": {"$ref": "#/$defs/caseResult"}
    },
    "parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compared_case_count", "field_difference_count", "field_differences", "semantic_results_sha256"],
      "properties": {
        "compared_case_count": {"const": 40},
        "field_difference_count": {"type": "integer", "minimum": 0},
        "field_differences": {"type": "array"},
        "semantic_results_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["common_weighted_score", "boundary_exact_rejection_rate", "critical_field_mismatch_count", "threshold_failure_count", "threshold_failures", "threshold_status"],
      "properties": {
        "common_weighted_score": {"type": "number", "minimum": 0, "maximum": 1},
        "boundary_exact_rejection_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "critical_field_mismatch_count": {"type": "integer", "minimum": 0},
        "threshold_failure_count": {"type": "integer", "minimum": 0},
        "threshold_failures": {"type": "array", "items": {"type": "string"}},
        "threshold_status": {"const": "local_candidate_frozen"}
      }
    },
    "latency": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"$ref": "#/$defs/latencySummary"}
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "total_cost_usd", "model_call_count", "tool_call_count", "cost_basis"],
      "properties": {
        "currency": {"const": "USD"},
        "total_cost_usd": {"const": 0},
        "model_call_count": {"const": 0},
        "tool_call_count": {"const": 0},
        "cost_basis": {"type": "string", "minLength": 1}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pii_canary_leak_count", "missing_audit_receipt_count"],
      "properties": {
        "pii_canary_leak_count": {"const": 0},
        "missing_audit_receipt_count": {"const": 0}
      }
    },
    "unexpected_dataset_diff": {"const": 0},
    "production_write_count": {"const": 0}
  },
  "$defs": {
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "case_class", "adapter_id", "outcome", "failure_code", "candidate_day_count", "weighted_score", "critical_field_mismatch_count", "formal_write_count", "warning_codes", "latency_ns", "model_call_count", "tool_call_count", "cost_usd", "audit_receipt_id"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^E0-[CB][0-9]{3}$"},
        "case_class": {"enum": ["common", "boundary"]},
        "adapter_id": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["candidate", "rejected"]},
        "failure_code": {"type": ["string", "null"]},
        "candidate_day_count": {"type": "integer", "minimum": 0},
        "weighted_score": {"type": "number", "minimum": 0, "maximum": 1},
        "critical_field_mismatch_count": {"type": "integer", "minimum": 0},
        "formal_write_count": {"const": 0},
        "warning_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "latency_ns": {"type": "integer", "minimum": 0},
        "model_call_count": {"const": 0},
        "tool_call_count": {"const": 0},
        "cost_usd": {"const": 0},
        "audit_receipt_id": {"type": "string", "pattern": "^audit://local-e0/"}
      }
    },
    "latencySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "min_ns", "p50_ns", "p95_ns", "max_ns"],
      "properties": {
        "sample_count": {"const": 40},
        "min_ns": {"type": "integer", "minimum": 0},
        "p50_ns": {"type": "integer", "minimum": 0},
        "p95_ns": {"type": "integer", "minimum": 0},
        "max_ns": {"type": "integer", "minimum": 0}
      }
    }
  }
}
