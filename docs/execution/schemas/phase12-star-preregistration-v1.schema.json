{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase12-star-preregistration-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate",
    "status",
    "claim_type",
    "metric_scope",
    "bindings",
    "primary_result",
    "diagnostic",
    "guardrails",
    "redlines",
    "statistical_plan",
    "run_record_contract",
    "decision_rule",
    "no_claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate": {"enum": ["P12A", "P12B", "P12D"]},
    "status": {"const": "preregistered_dormant_unbound"},
    "claim_type": {"const": "behavior_improvement"},
    "metric_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "not_applicable", "not_measured"],
      "properties": {
        "included": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
        "not_applicable": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "not_measured": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_oid", "candidate_oid", "dataset_sha256", "evaluator_version", "behavior_digest", "model_and_parameters", "toolset_version", "database_version", "seeds", "repeat_count", "runner_hardware", "time_window"],
      "properties": {
        "baseline_oid": {"const": "pending_exact_accepted_release_b_head"},
        "candidate_oid": {"const": "pending_selected_candidate_head"},
        "dataset_sha256": {"const": "pending_trigger_evidence_binding"},
        "evaluator_version": {"const": "pending_premeasurement_binding"},
        "behavior_digest": {"const": "pending_premeasurement_binding"},
        "model_and_parameters": {"const": "pending_premeasurement_binding"},
        "toolset_version": {"const": "pending_premeasurement_binding"},
        "database_version": {"const": "pending_premeasurement_binding"},
        "seeds": {"const": "pending_premeasurement_binding"},
        "repeat_count": {"const": "pending_power_analysis_then_freeze"},
        "runner_hardware": {"const": "pending_premeasurement_binding"},
        "time_window": {"const": "pending_premeasurement_binding"}
      }
    },
    "primary_result": {"$ref": "#/$defs/metric"},
    "diagnostic": {"$ref": "#/$defs/metric"},
    "guardrails": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/metric"}
    },
    "redlines": {
      "type": "array",
      "minItems": 2,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/metric"},
          {"properties": {"threshold": {"const": "0 hard_redline"}, "averaging_allowed": {"const": false}}}
        ]
      }
    },
    "statistical_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison_unit", "pairing", "estimator", "confidence_level", "interval_method", "stratification", "power_and_sample_size", "missing_run_handling", "outlier_handling", "zero_success_handling", "multiple_comparison_rule"],
      "properties": {
        "comparison_unit": {"type": "string", "minLength": 1},
        "pairing": {"type": "string", "minLength": 1},
        "estimator": {"type": "string", "minLength": 1},
        "confidence_level": {"const": 0.95},
        "interval_method": {"type": "string", "minLength": 1},
        "stratification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "power_and_sample_size": {"const": "freeze_from_baseline_or_blinded_pilot_before_candidate_unblinding"},
        "missing_run_handling": {"type": "string", "minLength": 1},
        "outlier_handling": {"type": "string", "minLength": 1},
        "zero_success_handling": {"const": "undefined_fail_closed"},
        "multiple_comparison_rule": {"type": "string", "minLength": 1}
      }
    },
    "run_record_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "required_fields", "content_exclusions", "failure_taxonomy_version"],
      "properties": {
        "schema_ref": {"const": "AGENTS.md §15.3.3"},
        "required_fields": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "content_exclusions": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "failure_taxonomy_version": {"const": "AGENTS-1.7.0"}
      }
    },
    "decision_rule": {"type": "string", "minLength": 1},
    "no_claim_boundary": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "role", "formula", "numerator", "denominator", "unit", "direction", "threshold", "threshold_source", "success_definition", "failure_definition", "averaging_allowed"],
      "properties": {
        "metric_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["primary_result", "diagnostic", "guardrail", "redline"]},
        "formula": {"type": "string", "minLength": 1},
        "numerator": {"type": "string", "minLength": 1},
        "denominator": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "direction": {"enum": ["higher", "lower", "zero"]},
        "threshold": {"type": "string", "minLength": 1},
        "threshold_source": {"type": "string", "minLength": 1},
        "success_definition": {"type": "string", "minLength": 1},
        "failure_definition": {"type": "string", "minLength": 1},
        "averaging_allowed": {"type": "boolean"}
      }
    }
  }
}
