{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase12-trigger-evidence-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate",
    "task_id",
    "release_b_head_oid",
    "dataset_sha256",
    "source_window",
    "denominator",
    "exclusion_rules",
    "estimator",
    "uncertainty",
    "trigger_threshold",
    "trigger_decision",
    "package_fields",
    "owner_decision_ref",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate": {"enum": ["P12A", "P12B", "P12D"]},
    "task_id": {"pattern": "^TASK-P12[ABD]-010$"},
    "release_b_head_oid": {"pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"},
    "dataset_sha256": {"pattern": "^[a-f0-9]{64}$"},
    "source_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_at", "end_at", "timezone"],
      "properties": {
        "start_at": {"type": "string", "format": "date-time"},
        "end_at": {"type": "string", "format": "date-time"},
        "timezone": {"const": "Asia/Shanghai"}
      }
    },
    "denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "value", "unit"],
      "properties": {
        "metric_id": {"type": "string", "minLength": 1},
        "value": {"type": "integer", "minimum": 1},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "exclusion_rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "estimator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "formula"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "formula": {"type": "string", "minLength": 1}
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence_level", "interval_method", "lower", "upper"],
      "properties": {
        "confidence_level": {"type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1},
        "interval_method": {"type": "string", "minLength": 1},
        "lower": {"type": "number"},
        "upper": {"type": "number"}
      }
    },
    "trigger_threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "operator", "value", "unit", "source_ref"],
      "properties": {
        "metric_id": {"type": "string", "minLength": 1},
        "operator": {"enum": [">", ">=", "<", "<="]},
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1}
      }
    },
    "trigger_decision": {"enum": ["positive", "negative"]},
    "package_fields": {"type": "object"},
    "owner_decision_ref": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"candidate": {"const": "P12A"}}},
      "then": {
        "properties": {
          "task_id": {"const": "TASK-P12A-010"},
          "package_fields": {
            "type": "object",
            "additionalProperties": false,
            "required": ["calibrated_trigger", "eligible_failure_numerator", "consent_purpose_decision_ref", "licensed_deidentified_dataset"],
            "properties": {
              "calibrated_trigger": {"type": "string", "minLength": 1},
              "eligible_failure_numerator": {"type": "integer", "minimum": 0},
              "consent_purpose_decision_ref": {"type": "string", "minLength": 1},
              "licensed_deidentified_dataset": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"candidate": {"const": "P12B"}}},
      "then": {
        "properties": {
          "task_id": {"const": "TASK-P12B-010"},
          "package_fields": {
            "type": "object",
            "additionalProperties": false,
            "required": ["complete_comparable_weeks", "price_snapshot_version", "price_snapshot_sha256", "tco_formula", "quality_noninferiority_margin_pp"],
            "properties": {
              "complete_comparable_weeks": {"type": "integer", "minimum": 4},
              "price_snapshot_version": {"type": "string", "minLength": 1},
              "price_snapshot_sha256": {"pattern": "^[a-f0-9]{64}$"},
              "tco_formula": {"type": "string", "minLength": 1},
              "quality_noninferiority_margin_pp": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"candidate": {"const": "P12D"}}},
      "then": {
        "properties": {
          "task_id": {"const": "TASK-P12D-010"},
          "package_fields": {
            "type": "object",
            "additionalProperties": false,
            "required": ["selected_write_entry", "selected_primary_metric_id", "impact_map_sha256", "unknown_critical_side_effect_count"],
            "properties": {
              "selected_write_entry": {"type": "string", "minLength": 1},
              "selected_primary_metric_id": {
                "enum": [
                  "none",
                  "duplicate_effect_rate_per_10k_intents",
                  "partial_write_or_event_loss_rate_per_10k_intents",
                  "ambiguous_outcome_manual_repair_minutes_per_1k_intents",
                  "stale_conflict_partial_effect_rate_per_10k_intents"
                ]
              },
              "impact_map_sha256": {"pattern": "^[a-f0-9]{64}$"},
              "unknown_critical_side_effect_count": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"candidate": {"const": "P12D"}, "trigger_decision": {"const": "positive"}},
        "required": ["candidate", "trigger_decision"]
      },
      "then": {
        "properties": {
          "package_fields": {
            "properties": {
              "selected_write_entry": {"not": {"const": "none"}},
              "selected_primary_metric_id": {"not": {"const": "none"}},
              "unknown_critical_side_effect_count": {"const": 0}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"candidate": {"const": "P12D"}, "trigger_decision": {"const": "negative"}},
        "required": ["candidate", "trigger_decision"]
      },
      "then": {
        "properties": {
          "package_fields": {
            "properties": {
              "selected_write_entry": {"const": "none"},
              "selected_primary_metric_id": {"const": "none"}
            }
          }
        }
      }
    }
  ]
}
