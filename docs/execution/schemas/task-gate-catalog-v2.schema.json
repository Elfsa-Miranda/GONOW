{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"task-gate-catalog-v2",
  "type":"object",
  "additionalProperties":false,
  "required":["SchemaVersion","CatalogVersion","SupersedesCatalogSha256","BootstrapStage","CapabilityResolvers","TaskGateModeContracts","PhaseMergeModeContracts","Tasks"],
  "properties":{
    "SchemaVersion":{"const":"2.0"},
    "CatalogVersion":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "SupersedesCatalogSha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},
    "BootstrapStage":{"enum":["native","locked_pending_revalidation","locked_validated"]},
    "CapabilityResolvers":{"type":"object","additionalProperties":false,"required":["Native","Locked"],
      "properties":{
        "Native":{"type":"object","additionalProperties":{"$ref":"#/$defs/capability"}},
        "Locked":{"type":"object","additionalProperties":{"$ref":"#/$defs/capability"}}
      }},
    "TaskGateModeContracts":{"type":"object","minProperties":23,"maxProperties":23,
      "required":["AcceptancePreflight","ApprovalValidation","ArchitectureArtifactRegister","BootstrapEvidenceImport","BootstrapSelfTest","BootstrapToolchainRevalidation","BuildAcceptance","CatalogRevision","ClockSafety","DependencyAudit","Documentation","Evidence","HandoffVerification","HarnessCatalogAggregate","Preflight","Regression","RollbackDrill","RollbackVerify","Security","StatusBoardAggregate","Verify","WorkPreflight","WorksetVerify"],
      "propertyNames":{"enum":["AcceptancePreflight","ApprovalValidation","ArchitectureArtifactRegister","BootstrapEvidenceImport","BootstrapSelfTest","BootstrapToolchainRevalidation","BuildAcceptance","CatalogRevision","ClockSafety","DependencyAudit","Documentation","Evidence","HandoffVerification","HarnessCatalogAggregate","Preflight","Regression","RollbackDrill","RollbackVerify","Security","StatusBoardAggregate","Verify","WorkPreflight","WorksetVerify"]},
      "additionalProperties":{"$ref":"#/$defs/modeContract"}},
    "PhaseMergeModeContracts":{"type":"object","minProperties":11,"maxProperties":11,
      "required":["Archive","Cleanup","CloseVerify","IntegrationSmoke","Merge","MergePreflight","MergeTreeVerification","PostMergeEvidence","Retrospective","RollbackVerify","Security"],
      "propertyNames":{"enum":["Archive","Cleanup","CloseVerify","IntegrationSmoke","Merge","MergePreflight","MergeTreeVerification","PostMergeEvidence","Retrospective","RollbackVerify","Security"]},
      "additionalProperties":{"$ref":"#/$defs/modeContract"}},
    "Tasks":{"type":"object","minProperties":153,"maxProperties":153,
      "propertyNames":{"pattern":"^TASK-[A-Z0-9-]+$"},
      "additionalProperties":{"$ref":"#/$defs/task"}}
  },
  "$defs":{
    "stringArray":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "stageArray":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["native","locked_pending_revalidation","locked_validated"]}},
    "roleArray":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["Engineering","Architecture","Security","Data","Product","Privacy","SRE","Eval","Domain","Compliance"]}},
    "taskGateModeArray":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["AcceptancePreflight","ApprovalValidation","ArchitectureArtifactRegister","BootstrapEvidenceImport","BootstrapSelfTest","BootstrapToolchainRevalidation","BuildAcceptance","CatalogRevision","ClockSafety","DependencyAudit","Documentation","Evidence","HandoffVerification","HarnessCatalogAggregate","Preflight","Regression","RollbackDrill","RollbackVerify","Security","StatusBoardAggregate","Verify","WorkPreflight","WorksetVerify"]}},
    "phaseMergeModeArray":{"type":"array","uniqueItems":true,"items":{"enum":["Archive","Cleanup","CloseVerify","IntegrationSmoke","Merge","MergePreflight","MergeTreeVerification","PostMergeEvidence","Retrospective","RollbackVerify","Security"]}},
    "capability":{"type":"object","additionalProperties":false,
      "required":["resolver_kind","source","required_after_stage"],
      "properties":{
        "resolver_kind":{"enum":["absolute_native","lock_json_pointer"]},
        "source":{"type":"string","minLength":1},
        "required_after_stage":{"enum":["native","locked_validated"]}
      }},
    "modeContract":{"type":"object","additionalProperties":false,
      "required":["handler","allowed_bootstrap_stages","required_task_fields","required_capabilities","read_set_kind","write_set_kind","output_schema","success_predicates","failure_transition"],
      "properties":{
        "handler":{"type":"string","pattern":"^Invoke-(?:Mode|MergeMode)[A-Za-z0-9]+$"},
        "allowed_bootstrap_stages":{"$ref":"#/$defs/stageArray"},
        "required_task_fields":{"$ref":"#/$defs/stringArray"},
        "required_capabilities":{"$ref":"#/$defs/stringArray"},
        "read_set_kind":{"type":"string","minLength":1},
        "write_set_kind":{"type":"string","minLength":1},
        "output_schema":{"type":"string","minLength":1},
        "success_predicates":{"$ref":"#/$defs/stringArray"},
        "failure_transition":{"const":"blocked"}
      }},
    "command":{"type":"object","additionalProperties":false,
      "required":["command_id","executable_capability","arguments","expected_exit_codes","stdout_regex","stderr_regex","timeout_seconds","redaction_profile"],
      "properties":{
        "command_id":{"type":"string","minLength":1},
        "executable_capability":{"type":"string","minLength":1},
        "arguments":{"type":"array","items":{"type":"string"}},
        "expected_exit_codes":{"type":"array","minItems":1,"items":{"type":"integer"},"uniqueItems":true},
        "stdout_regex":{"type":"string"},"stderr_regex":{"type":"string"},
        "timeout_seconds":{"type":"integer","minimum":1},
        "redaction_profile":{"type":"string","minLength":1}
      }},
    "workContract":{"type":"object","additionalProperties":false,
      "required":["repo_patch_targets","external_actions","read_only_queries","required_changes","forbidden_changes","postconditions"],
      "properties":{
        "repo_patch_targets":{"$ref":"#/$defs/stringArray"},
        "external_actions":{"type":"array","items":{"$ref":"#/$defs/externalAction"}},
        "read_only_queries":{"type":"array","items":{"$ref":"#/$defs/command"}},
        "required_changes":{"$ref":"#/$defs/stringArray"},
        "forbidden_changes":{"$ref":"#/$defs/stringArray"},
        "postconditions":{"$ref":"#/$defs/stringArray"}
      }},
    "externalAction":{"type":"object","additionalProperties":false,
      "required":["adapter_capability","identity","target","arguments","idempotency_or_cas","receipt","rollback"],
      "properties":{
        "adapter_capability":{"type":"string","minLength":1},
        "identity":{"type":"string","minLength":1},
        "target":{"type":"string","minLength":1},
        "arguments":{"type":"array","items":{"type":"string"}},
        "idempotency_or_cas":{"type":"string","minLength":1},
        "receipt":{"type":"string","minLength":1},
        "rollback":{"type":"string","minLength":1}
      }},
    "approvalPolicy":{"type":"object","additionalProperties":false,
      "required":["required_roles","minimum_approvals","independent_from_implementer","validity_rule"],
      "properties":{
        "required_roles":{"$ref":"#/$defs/roleArray"},
        "minimum_approvals":{"type":"integer","minimum":1},
        "independent_from_implementer":{"const":true},
        "validity_rule":{"type":"string","minLength":1}
      }},
    "task":{"type":"object","additionalProperties":false,
      "required":["task_id","phase","catalog_version","owner_alias","owner_roles","reviewer_roles","approval_policy","required_bootstrap_stage","allowed_taskgate_modes","allowed_phase_merge_modes","file_allowlist","directory_allowlist","external_root_allowlist","read_only_inputs","evidence_outputs","status_file","status_schema","prerequisite_task_ids","phase_base_source_ref","phase_runtime_manifest_path","bootstrap_materialization_for","work_contract","work_preflight_commands","workset_verify_commands","verify_commands","security_check_ids","applicable_ct_ids","harness_controls_owned","harness_controls_extended","dependency_change","rollback_commands","expected_assertions","timeout_seconds","mutates_repo","evidence_schemas","catalog_revision"],
      "properties":{
        "task_id":{"type":"string","pattern":"^TASK-[A-Z0-9-]+$"},
        "phase":{"type":"string","minLength":1},
        "catalog_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "owner_alias":{"type":"string","minLength":1},
        "owner_roles":{"$ref":"#/$defs/roleArray"},
        "reviewer_roles":{"$ref":"#/$defs/roleArray"},
        "approval_policy":{"$ref":"#/$defs/approvalPolicy"},
        "required_bootstrap_stage":{"enum":["native","locked_validated"]},
        "allowed_taskgate_modes":{"$ref":"#/$defs/taskGateModeArray"},
        "allowed_phase_merge_modes":{"$ref":"#/$defs/phaseMergeModeArray"},
        "file_allowlist":{"$ref":"#/$defs/stringArray"},
        "directory_allowlist":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["path","name_regex"],"properties":{"path":{"type":"string"},"name_regex":{"type":"string"}}}},
        "external_root_allowlist":{"$ref":"#/$defs/stringArray"},
        "read_only_inputs":{"$ref":"#/$defs/stringArray"},
        "evidence_outputs":{"$ref":"#/$defs/stringArray"},
        "status_file":{"type":"string","pattern":"^docs/execution/status/TASK-[A-Z0-9-]+\\.json$"},
        "status_schema":{"const":"task-status-v1"},
        "prerequisite_task_ids":{"$ref":"#/$defs/stringArray"},
        "phase_base_source_ref":{"type":["string","null"]},
        "phase_runtime_manifest_path":{"type":["string","null"]},
        "bootstrap_materialization_for":{"$ref":"#/$defs/stringArray"},
        "work_contract":{"$ref":"#/$defs/workContract"},
        "work_preflight_commands":{"type":"array","items":{"$ref":"#/$defs/command"}},
        "workset_verify_commands":{"type":"array","items":{"$ref":"#/$defs/command"}},
        "verify_commands":{"type":"array","items":{"$ref":"#/$defs/command"}},
        "security_check_ids":{"$ref":"#/$defs/stringArray"},
        "applicable_ct_ids":{"$ref":"#/$defs/stringArray"},
        "harness_controls_owned":{"$ref":"#/$defs/stringArray"},
        "harness_controls_extended":{"$ref":"#/$defs/stringArray"},
        "dependency_change":{"type":"boolean"},
        "rollback_commands":{"type":"array","items":{"$ref":"#/$defs/command"}},
        "expected_assertions":{"$ref":"#/$defs/stringArray"},
        "timeout_seconds":{"type":"integer","minimum":1},
        "mutates_repo":{"type":"boolean"},
        "evidence_schemas":{"type":"object","additionalProperties":false,"required":["commands","gate_results","artifact_hashes","task_status"],"properties":{"commands":{"const":"commands-v1"},"gate_results":{"const":"gate-results-v1"},"artifact_hashes":{"const":"artifact-hashes-v1"},"task_status":{"const":"task-status-v1"},"harness_status_fragment":{"const":"harness-status-fragment-v1"}}},
        "catalog_revision":{"type":"boolean"}
      }}
  }
}
