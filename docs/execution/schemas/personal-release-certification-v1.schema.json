{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "personal-release-certification-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "profile",
    "governance_profile",
    "candidate_head_oid",
    "git_object_format",
    "evidence_type",
    "production_observation_required",
    "automated_gate_acceptance",
    "config_sha256",
    "runner_sha256",
    "manifest_sha256",
    "gate_count",
    "certification_gate_pass_count",
    "certification_gate_failure_count",
    "mandatory_skip_count",
    "xfail_count",
    "flaky_rerun_count",
    "candidate_drift_count",
    "production_write_count",
    "redline_failure_count",
    "gates",
    "residual_risk",
    "overall_status",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"const": "TASK-P10-009"},
    "profile": {"const": "ReleaseBDeep"},
    "governance_profile": {"const": "personal_automated"},
    "candidate_head_oid": {"type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"},
    "git_object_format": {"enum": ["sha1", "sha256"]},
    "evidence_type": {"const": "personal_compressed_release_certification"},
    "production_observation_required": {"const": false},
    "automated_gate_acceptance": {"const": true},
    "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runner_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gate_count": {"const": 5},
    "certification_gate_pass_count": {"type": "integer", "minimum": 0, "maximum": 5},
    "certification_gate_failure_count": {"type": "integer", "minimum": 0, "maximum": 5},
    "mandatory_skip_count": {"type": "integer", "minimum": 0},
    "xfail_count": {"type": "integer", "minimum": 0},
    "flaky_rerun_count": {"type": "integer", "minimum": 0},
    "candidate_drift_count": {"type": "integer", "minimum": 0},
    "production_write_count": {"type": "integer", "minimum": 0},
    "redline_failure_count": {"type": "integer", "minimum": 0},
    "gates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "status", "report_path", "report_sha256", "failure_codes"],
        "properties": {
          "gate_id": {"enum": ["C1", "C2", "C3", "C4", "C5"]},
          "status": {"enum": ["passed", "blocked", "failed"]},
          "report_path": {"type": "string", "minLength": 1},
          "report_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "failure_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "residual_risk": {"const": "not_validated_against_31_day_real_user_and_infrastructure_drift"},
    "overall_status": {"enum": ["passed", "blocked", "failed"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
