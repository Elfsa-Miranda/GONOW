{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gonow.invalid/schemas/e0-dataset-v1.json",
  "title": "GoNow E0 synthetic planning contract",
  "oneOf": [
    {"$ref": "#/$defs/requestRecord"},
    {"$ref": "#/$defs/labelRecord"}
  ],
  "$defs": {
    "caseId": {"type": "string", "pattern": "^E0-[CB][0-9]{3}$"},
    "requestRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "schema_version", "case_id", "case_class", "source", "request"],
      "properties": {
        "record_type": {"const": "request"},
        "schema_version": {"const": "1.0"},
        "case_id": {"$ref": "#/$defs/caseId"},
        "case_class": {"enum": ["common", "boundary"]},
        "source": {"const": "synthetic_e0_v1"},
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "destination", "days", "budget", "currency", "locale", "pace", "interests", "hard_constraints"],
          "properties": {
            "origin": {"type": ["string", "null"]},
            "destination": {"type": ["string", "null"]},
            "days": {"type": "integer", "minimum": -100, "maximum": 1000},
            "budget": {"type": "number", "minimum": -1000000, "maximum": 10000000},
            "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
            "locale": {"type": "string"},
            "pace": {"enum": ["leisurely", "balanced", "packed", "contradictory"]},
            "interests": {"type": "array", "items": {"type": "string"}, "maxItems": 12},
            "hard_constraints": {"type": "array", "items": {"type": "string"}, "maxItems": 16}
          }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "target", "operator", "expected"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
        "target": {"type": "string"},
        "operator": {"enum": ["equals", "count_equals", "is_null", "is_sorted", "no_overlap", "lte"]},
        "expected": {}
      }
    },
    "labelRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "schema_version", "case_id", "case_class", "expected_outcome", "expected_failure_code", "hard_requirements", "ordering_rules", "conflict_rules", "critical_fields", "warning_codes"],
      "properties": {
        "record_type": {"const": "label"},
        "schema_version": {"const": "1.0"},
        "case_id": {"$ref": "#/$defs/caseId"},
        "case_class": {"enum": ["common", "boundary"]},
        "expected_outcome": {"enum": ["candidate", "rejected"]},
        "expected_failure_code": {"type": ["string", "null"]},
        "hard_requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
        "ordering_rules": {"type": "array", "items": {"type": "string"}},
        "conflict_rules": {"type": "array", "items": {"type": "string"}},
        "critical_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "warning_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
