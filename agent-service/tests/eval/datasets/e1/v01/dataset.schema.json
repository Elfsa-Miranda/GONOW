{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gonow.invalid/schemas/e1-dataset-v01.json",
  "title": "GoNow synthetic E1 evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "source",
    "split",
    "case_class",
    "locale",
    "journey",
    "expected_outcome",
    "expected_failure_code",
    "tags"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^E1-[0-9]{4}$"
    },
    "source": {
      "const": "synthetic_e1_v01"
    },
    "split": {
      "enum": [
        "baseline",
        "recent",
        "holdout"
      ]
    },
    "case_class": {
      "enum": [
        "common",
        "boundary"
      ]
    },
    "locale": {
      "enum": [
        "en",
        "zh-CN",
        "es",
        "fr",
        "ja"
      ]
    },
    "journey": {
      "enum": [
        "itinerary_create",
        "resume_cancel",
        "candidate_adopt",
        "weak_network",
        "legacy_fallback"
      ]
    },
    "expected_outcome": {
      "enum": [
        "candidate",
        "rejected"
      ]
    },
    "expected_failure_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_.-]+$"
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    }
  }
}
