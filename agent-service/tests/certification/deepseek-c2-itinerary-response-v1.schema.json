{
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 31,
      "items": {
        "type": "object",
        "properties": {
          "day_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "object",
              "properties": {
                "item_id": {
                  "type": "string",
                  "pattern": "^item_[a-z0-9_-]{1,80}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "start_minute": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1439
                },
                "duration_minutes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1440
                },
                "claim_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^knowledge_[0-9a-f]{16}$"
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "item_id",
                "title",
                "start_minute",
                "duration_minutes"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "day_number",
          "items"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "days"
  ],
  "additionalProperties": false
}
