{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gonow.example/contracts/behavior-manifest-v1.schema.json",
  "title": "GoNow Behavior Package manifest v1",
  "description": "Immutable references that freeze a complete Behavior Package. Prompt, secret, response, and reasoning bodies are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "behavior_key", "release_version", "components"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "behavior_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,126}$"
    },
    "release_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph",
        "state",
        "prompt",
        "context",
        "tools",
        "model",
        "schemas",
        "eval",
        "slo",
        "budget",
        "rollback"
      ],
      "properties": {
        "graph": {"$ref": "#/$defs/componentRef", "properties": {"artifact_ref": {"pattern": "^graph://sha256/[0-9a-f]{64}$"}}},
        "state": {"$ref": "#/$defs/componentRef", "properties": {"artifact_ref": {"pattern": "^state://sha256/[0-9a-f]{64}$"}}},
        "prompt": {"$ref": "#/$defs/componentRef", "properties": {"artifact_ref": {"pattern": "^prompt://sha256/[0-9a-f]{64}$"}}},
        "context": {"$ref": "#/$defs/componentRef", "properties": {"artifact_ref": {"pattern": "^context://sha256/[0-9a-f]{64}$"}}},
        "tools": {"$ref": "#/$defs/componentRef", "properties": {"artifact_ref": {"pattern": "^tools://sha256/[0-9a-f]{64}$"}}},
        "model": {"$ref": "#/$defs/componentRef", "properties": {"artifact_ref": {"pattern": "^model://sha256/[0-9a-f]{64}$"}}},
        "schemas": {"$ref": "#/$defs/componentRef", "properties": {"artifact_ref": {"pattern": "^schemas://sha256/[0-9a-f]{64}$"}}},
        "eval": {"$ref": "#/$defs/componentRef", "properties": {"artifact_ref": {"pattern": "^eval://sha256/[0-9a-f]{64}$"}}},
        "slo": {"$ref": "#/$defs/componentRef", "properties": {"artifact_ref": {"pattern": "^slo://sha256/[0-9a-f]{64}$"}}},
        "budget": {"$ref": "#/$defs/componentRef", "properties": {"artifact_ref": {"pattern": "^budget://sha256/[0-9a-f]{64}$"}}},
        "rollback": {"$ref": "#/$defs/componentRef", "properties": {"artifact_ref": {"pattern": "^rollback://sha256/[0-9a-f]{64}$"}}}
      }
    }
  },
  "$defs": {
    "componentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "sha256"],
      "properties": {
        "artifact_ref": {"type": "string", "maxLength": 160},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
