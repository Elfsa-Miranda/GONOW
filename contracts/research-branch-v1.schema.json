{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gonow.example/contracts/research-branch-v1.schema.json",
  "title": "GoNow bounded research branch contracts v1",
  "description": "Typed read-only Request, EvidenceBundle and MergeDecision payloads. Unknown versions, unknown fields and write authority fail closed.",
  "oneOf": [
    { "$ref": "#/$defs/researchRequest" },
    { "$ref": "#/$defs/evidenceBundle" },
    { "$ref": "#/$defs/mergeDecision" }
  ],
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri", "sha256"],
      "properties": {
        "kind": { "enum": ["objective", "requirement", "source", "evidence", "candidate"] },
        "uri": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9+.-]*://[^\\s]{1,500}$",
          "maxLength": 512
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "objectiveReference": {
      "allOf": [
        { "$ref": "#/$defs/reference" },
        { "properties": { "kind": { "const": "objective" } } }
      ]
    },
    "requirementReference": {
      "allOf": [
        { "$ref": "#/$defs/reference" },
        { "properties": { "kind": { "const": "requirement" } } }
      ]
    },
    "evidenceReference": {
      "allOf": [
        { "$ref": "#/$defs/reference" },
        { "properties": { "kind": { "enum": ["source", "evidence"] } } }
      ]
    },
    "candidateReference": {
      "allOf": [
        { "$ref": "#/$defs/reference" },
        { "properties": { "kind": { "const": "candidate" } } }
      ]
    },
    "researchFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_code", "assessment", "evidence_refs"],
      "properties": {
        "finding_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "maxLength": 128
        },
        "assessment": { "enum": ["verified", "warning", "unverified"] },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceReference" }
        }
      }
    },
    "researchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract_kind",
        "request_id",
        "run_id",
        "branch_id",
        "objective_ref",
        "requirement_refs",
        "permission",
        "allowed_operations",
        "output_contract"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "contract_kind": { "const": "research_request" },
        "request_id": { "type": "string", "format": "uuid" },
        "run_id": { "type": "string", "format": "uuid" },
        "branch_id": { "enum": ["branch_a", "branch_b"] },
        "objective_ref": { "$ref": "#/$defs/objectiveReference" },
        "requirement_refs": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requirementReference" }
        },
        "permission": { "const": "read_only" },
        "allowed_operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["evidence.search", "evidence.retrieve"] }
        },
        "output_contract": { "const": "evidence_bundle_v1" }
      }
    },
    "evidenceBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract_kind",
        "bundle_id",
        "request_id",
        "run_id",
        "branch_id",
        "findings",
        "completion",
        "domain_write_authorized"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "contract_kind": { "const": "evidence_bundle" },
        "bundle_id": { "type": "string", "format": "uuid" },
        "request_id": { "type": "string", "format": "uuid" },
        "run_id": { "type": "string", "format": "uuid" },
        "branch_id": { "enum": ["branch_a", "branch_b"] },
        "findings": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/researchFinding" }
        },
        "completion": { "enum": ["complete", "partial"] },
        "domain_write_authorized": { "const": false }
      }
    },
    "mergeDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract_kind",
        "decision_id",
        "run_id",
        "bundle_ids",
        "outcome",
        "selected_finding_codes",
        "rationale_codes",
        "candidate_ref",
        "domain_write_authorized"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "contract_kind": { "const": "merge_decision" },
        "decision_id": { "type": "string", "format": "uuid" },
        "run_id": { "type": "string", "format": "uuid" },
        "bundle_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uuid" }
        },
        "outcome": { "enum": ["merged", "insufficient_evidence", "rejected"] },
        "selected_finding_codes": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "rationale_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "candidate_ref": {
          "oneOf": [
            { "$ref": "#/$defs/candidateReference" },
            { "type": "null" }
          ]
        },
        "domain_write_authorized": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": { "outcome": { "const": "merged" } },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "selected_finding_codes": { "minItems": 1 },
              "candidate_ref": { "$ref": "#/$defs/candidateReference" }
            }
          },
          "else": {
            "properties": {
              "selected_finding_codes": { "maxItems": 0 },
              "candidate_ref": { "type": "null" }
            }
          }
        }
      ]
    }
  }
}
