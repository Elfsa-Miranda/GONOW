{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gonow.example/contracts/knowledge-package-v1.schema.json",
  "title": "GoNow Knowledge Package manifest v1",
  "description": "An immutable, tenant-bound retrieval release. Content, credentials, prompts, responses, and reasoning are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "package_key",
    "package_version",
    "manifest",
    "components"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "package_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,126}$"
    },
    "package_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "manifest_digest"],
      "properties": {
        "manifest_id": {"type": "string", "format": "uuid"},
        "manifest_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenizer",
        "embedding",
        "dictionary",
        "fusion",
        "reranker",
        "citations",
        "eval",
        "rollback"
      ],
      "properties": {
        "tokenizer": {"$ref": "#/$defs/componentRef"},
        "embedding": {"$ref": "#/$defs/componentRef"},
        "dictionary": {"$ref": "#/$defs/componentRef"},
        "fusion": {"$ref": "#/$defs/componentRef"},
        "reranker": {"$ref": "#/$defs/componentRef"},
        "citations": {"$ref": "#/$defs/componentRef"},
        "eval": {"$ref": "#/$defs/componentRef"},
        "rollback": {"$ref": "#/$defs/componentRef"}
      }
    }
  },
  "$defs": {
    "componentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "sha256"],
      "properties": {
        "artifact_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*://sha256/[0-9a-f]{64}$",
          "maxLength": 160
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
