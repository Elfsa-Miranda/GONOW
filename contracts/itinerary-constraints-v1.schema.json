{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gonow.example.invalid/contracts/itinerary-constraints-v1.schema.json",
  "title": "GoNow itinerary constraints v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "constraints"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "constraints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/time"},
          {"$ref": "#/$defs/commute"},
          {"$ref": "#/$defs/opening_hours"},
          {"$ref": "#/$defs/budget"},
          {"$ref": "#/$defs/preference"}
        ]
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_id", "evidence_status", "evidence_ref"],
      "properties": {
        "kind": {"enum": ["user", "verified_tool", "approved_profile"]},
        "source_id": {"type": "string", "pattern": "^src_[a-z0-9_-]{1,80}$"},
        "evidence_status": {"enum": ["self_asserted", "verified"]},
        "evidence_ref": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^ev_[a-z0-9_-]{1,120}$"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "verified_tool"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "evidence_status": {"const": "verified"},
              "evidence_ref": {"type": "string", "pattern": "^ev_[a-z0-9_-]{1,120}$"}
            }
          }
        }
      ]
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "kind", "priority", "source", "description", "day_number", "start_minute", "end_minute"],
      "properties": {
        "constraint_id": {"type": "string", "pattern": "^constraint_[a-z0-9_-]{1,80}$"},
        "kind": {"const": "time"},
        "priority": {"enum": ["hard", "preference"]},
        "source": {"$ref": "#/$defs/source"},
        "description": {"type": "string", "minLength": 1, "maxLength": 240},
        "day_number": {"type": "integer", "minimum": 1, "maximum": 31},
        "start_minute": {"type": "integer", "minimum": 0, "maximum": 1439},
        "end_minute": {"type": "integer", "minimum": 1, "maximum": 1440}
      }
    },
    "commute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "kind", "priority", "source", "description", "from_place_id", "to_place_id", "max_minutes", "allowed_modes"],
      "properties": {
        "constraint_id": {"type": "string", "pattern": "^constraint_[a-z0-9_-]{1,80}$"},
        "kind": {"const": "commute"},
        "priority": {"enum": ["hard", "preference"]},
        "source": {"$ref": "#/$defs/source"},
        "description": {"type": "string", "minLength": 1, "maxLength": 240},
        "from_place_id": {"type": "string", "pattern": "^place_[a-z0-9_-]{1,80}$"},
        "to_place_id": {"type": "string", "pattern": "^place_[a-z0-9_-]{1,80}$"},
        "max_minutes": {"type": "integer", "minimum": 0, "maximum": 480},
        "allowed_modes": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["walk", "transit", "taxi", "drive"]}}
      }
    },
    "opening_hours": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "kind", "priority", "source", "description", "place_id", "day_number", "open_minute", "close_minute"],
      "properties": {
        "constraint_id": {"type": "string", "pattern": "^constraint_[a-z0-9_-]{1,80}$"},
        "kind": {"const": "opening_hours"},
        "priority": {"enum": ["hard", "preference"]},
        "source": {"$ref": "#/$defs/source"},
        "description": {"type": "string", "minLength": 1, "maxLength": 240},
        "place_id": {"type": "string", "pattern": "^place_[a-z0-9_-]{1,80}$"},
        "day_number": {"type": "integer", "minimum": 1, "maximum": 31},
        "open_minute": {"type": "integer", "minimum": 0, "maximum": 1439},
        "close_minute": {"type": "integer", "minimum": 1, "maximum": 1440}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "kind", "priority", "source", "description", "currency", "min_minor", "max_minor"],
      "properties": {
        "constraint_id": {"type": "string", "pattern": "^constraint_[a-z0-9_-]{1,80}$"},
        "kind": {"const": "budget"},
        "priority": {"enum": ["hard", "preference"]},
        "source": {"$ref": "#/$defs/source"},
        "description": {"type": "string", "minLength": 1, "maxLength": 240},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "min_minor": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "max_minor": {"type": "integer", "minimum": 0, "maximum": 1000000000}
      }
    },
    "preference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "kind", "priority", "source", "description", "preference_key", "preference_value", "weight"],
      "properties": {
        "constraint_id": {"type": "string", "pattern": "^constraint_[a-z0-9_-]{1,80}$"},
        "kind": {"const": "preference"},
        "priority": {"const": "preference"},
        "source": {"$ref": "#/$defs/source"},
        "description": {"type": "string", "minLength": 1, "maxLength": 240},
        "preference_key": {"enum": ["accessibility", "pace", "cuisine", "lodging", "activity"]},
        "preference_value": {"type": "string", "minLength": 1, "maxLength": 80},
        "weight": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    }
  }
}
