{
  "schema_version": "1.0",
  "uid": "gonow-agent-operations",
  "title": "GoNow Agent Operations",
  "owner": "SRE",
  "variables": [
    {"name": "environment", "values": ["local", "staging", "production"]}
  ],
  "forbidden_group_by": [
    "behavior_digest",
    "email",
    "prompt",
    "request_id",
    "run_id",
    "tenant_id",
    "thread_id",
    "user_id"
  ],
  "panels": [
    {"title": "Run completions", "metric": "gonow_run_completed_total", "type": "counter", "unit": "count", "owner": "SRE"},
    {"title": "Run duration", "metric": "gonow_run_duration_ms", "type": "histogram", "unit": "ms", "owner": "SRE"},
    {"title": "Tool calls", "metric": "gonow_tool_calls_total", "type": "counter", "unit": "count", "owner": "Agent Platform"},
    {"title": "Tool duration", "metric": "gonow_tool_duration_ms", "type": "histogram", "unit": "ms", "owner": "Agent Platform"},
    {"title": "Context tokens", "metric": "gonow_context_tokens", "type": "gauge", "unit": "token", "owner": "Agent Platform"},
    {"title": "Context utilization", "metric": "gonow_context_utilization", "type": "histogram", "unit": "1", "owner": "Agent Platform"},
    {"title": "Validation results", "metric": "gonow_validation_total", "type": "counter", "unit": "count", "owner": "Quality"},
    {"title": "Validation duration", "metric": "gonow_validation_duration_ms", "type": "histogram", "unit": "ms", "owner": "Quality"},
    {"title": "Model cost", "metric": "gonow_model_cost_usd_total", "type": "counter", "unit": "usd", "owner": "Finance"},
    {"title": "Adopted task cost", "metric": "gonow_adopted_task_cost_usd", "type": "histogram", "unit": "usd", "owner": "Finance"},
    {"title": "Recovery attempts", "metric": "gonow_recovery_attempts_total", "type": "counter", "unit": "count", "owner": "SRE"},
    {"title": "Recovery duration", "metric": "gonow_recovery_duration_ms", "type": "histogram", "unit": "ms", "owner": "SRE"}
  ]
}
